@page "/findbooks"
@using Microsoft.Maui.Controls


<div class="header">
    <h1>Find a Book</h1>

    <label>Search Book ISBN:</label>
    <input />

    <label>Search Book Name:</label>
    <input />

    <label>Search Book Author:</label>
    <input />

    <label>Found Book Category:</label>
    <input />
</div>

<div>
    <select>
        @foreach(FindBooks books in allBooks)
        {
            <option></option>
        }
    </select>
</div>

<div>
    <h1>Selected Book</h1>

    <label>Found Book ID:</label>
    <input/>

    <label>Found Book Name:</label>
    <input />

    <label>Found Book Author:</label>
    <input />

    <label>Found Book Category:</label>
    <input />

    <button>Check out book</button>

    <button>Return Book</button>
</div>

@code {
    private List<FindBooks> allBooks = new List<FindBooks>();

}
